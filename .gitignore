# ===========================================================
# SOLIDA — .gitignore
# ===========================================================

_archive-instructions/

# --- Secrets et configuration locale ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
ACCES_DONNEES_LOCAL.txt
PAQUET_TRANSFERT_SOLIDA_*.zip
.secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.eslintcache
next-env.d.ts

# --- Données ---
# Aucune donnée, même synthétique, n'est versionnée. Elle se régénère.
data/
*.parquet
*.csv
*.db
*.sqlite3
!data/README.md
!modelisation/
!modelisation/data/
!modelisation/data/README.md
modelisation/data/*
!modelisation/data/README.md

# --- Modèles et artefacts ML ---
mlruns/
mlartifacts/
models/*.pkl
models/*.joblib
models/*.onnx
!models/README.md

# --- Infrastructure locale ---
.docker/
volumes/
pgdata/
miniodata/

# --- graphify : cache et etat local regenerables (garder graph.json et GRAPH_REPORT.md) ---
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.graphify_root
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig
graphify-out/manifest.json
graphify-out/graph.html

# --- Sorties générées ---
exports/
*.pdf
reports/

# --- Documents internes, hors code (non versionnés) ---
PLAN 72H/
.agents/
précision.txt
Togo_Sophos_DeclarationPI.tex
docs/continuite/
CLAUDE.md
AGENTS.md
graphify-out/
.api-notes.md

# --- Éditeurs et OS ---
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
*.swp

# --- Archives, documents et fichiers lourds ---
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.docx
*.pptx
*.xlsx
*.pkl
*.joblib
*.onnx
