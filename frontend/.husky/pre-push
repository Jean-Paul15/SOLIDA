#!/usr/bin/env sh
# Reproduit exactement les etapes de .github/workflows/frontend-ci.yml (dans le meme
# ordre) pour bloquer localement ce que la CI aurait refuse, avant meme le push.
racine=$(git rev-parse --show-toplevel)
export MSYS_NO_PATHCONV=1

docker run --rm \
  -v "$racine/frontend:/app" \
  -v solida_frontend_node_modules:/app/node_modules \
  -w /app \
  node:22 \
  sh -c "npm install --no-audit --no-fund --silent \
    && npm run lint \
    && npm run typecheck \
    && npm run test \
    && npm audit --audit-level=high \
    && npm run build"
