# Fichier versionne, documentation des variables attendues. Copier en .env (non versionne)
# et completer localement — .env n'est jamais commite.

CORESIM_ADMIN_USER=coresim_admin
CORESIM_ADMIN_PASSWORD=REMPLACER_MOI

SOLIDA_APP_USER=solida_app
SOLIDA_APP_PASSWORD=REMPLACER_MOI

SOLIDA_LECTEUR_PASSWORD=REMPLACER_MOI
SOLIDA_LECTURE_PASSWORD=REMPLACER_MOI
# Role dedie a la purge du journal d'audit (seul role, avec solida_app, ayant DELETE sur
# journal_audit — voir la migration du trigger d'immuabilite et purger_journal_audit.py).
SOLIDA_PURGE_PASSWORD=REMPLACER_MOI

# API backend (service "api" du docker-compose).
# CORESIM_DATABASE_URL utilise le role solida_lecteur (lecture seule, garde-fou en base).
# SOLIDA_DATABASE_URL(_ASYNC) utilise solida_app (lecture/ecriture) — meme forme d'URL pour
# les deux, le pilote psycopg 3 gere sync et async sous le meme schema "postgresql+psycopg://".
CORESIM_DATABASE_URL=postgresql+psycopg://solida_lecteur:REMPLACER_MOI@postgres-coresim:5432/coresim
SOLIDA_DATABASE_URL=postgresql+psycopg://solida_app:REMPLACER_MOI@postgres-solida:5432/solida
SOLIDA_DATABASE_URL_ASYNC=postgresql+psycopg://solida_app:REMPLACER_MOI@postgres-solida:5432/solida
SOLIDA_PURGE_DATABASE_URL=postgresql+psycopg://solida_purge:REMPLACER_MOI@postgres-solida:5432/solida

# Archivage des fiches PDF (SeaweedFS, passerelle S3) — identifiants du seul jeu de
# credentials configure, non lie a un compte utilisateur SOLIDA.
SEAWEEDFS_ACCESS_KEY=REMPLACER_MOI
SEAWEEDFS_SECRET_KEY=REMPLACER_MOI
# Adresse d'écoute de l'API S3 avec l'override `docker-compose.mlops-share.yml`.
# Garder 127.0.0.1 par défaut. Pour un autre PC, choisir une IP LAN/VPN, jamais 0.0.0.0
# sur un réseau non maîtrisé.
SEAWEEDFS_BIND_ADDRESS=127.0.0.1

# Modele SOCLE et suivi MLflow. Le bundle est recupere par DVC, jamais depuis Git.
MODELE_SOCLE_PATH=/app/modeles/bundle_socle
MODELE_SOCLE_CACHE_PATH=/var/cache/solida-modele
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_NAME=solida-socle
MLFLOW_MODEL_ALIAS=champion-demo
# Fournir ces valeurs puis lancer `docker compose --profile mlops up -d` pour activer le
# registre et les artefacts MLflow locaux. Elles ne sont pas utilisees lorsque le profil
# n'est pas lance ; l'API charge alors le bundle DVC verifie.
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=REMPLACER_MOI

# Secret de signature (reset password / verification FastAPI-Users). 32 octets alea minimum,
# jamais la valeur d'exemple ci-dessous en dehors du developpement local.
SECRET_AUTH=REMPLACER_MOI_PAR_UN_SECRET_ALEATOIRE_LONG

# Piloté par auth.py (cookie_secure = ENVIRONNEMENT == "production") : en "developpement", le
# cookie de session part sans le flag Secure. Toute instance exposee au-dela de localhost (y
# compris via un tunnel type Cloudflare) doit passer cette valeur a "production", meme si le
# deploiement reste par ailleurs local.
ENVIRONNEMENT=developpement
