# Fichier versionne, documentation des variables attendues. Copier en .env (non versionne)
# et completer localement — .env n'est jamais commite.

CORESIM_ADMIN_USER=coresim_admin
CORESIM_ADMIN_PASSWORD=REMPLACER_MOI

SOLIDA_APP_USER=solida_app
SOLIDA_APP_PASSWORD=REMPLACER_MOI

SOLIDA_LECTEUR_PASSWORD=REMPLACER_MOI
SOLIDA_LECTURE_PASSWORD=REMPLACER_MOI

# API backend (service "api" du docker-compose).
# CORESIM_DATABASE_URL utilise le role solida_lecteur (lecture seule, garde-fou en base).
# SOLIDA_DATABASE_URL(_ASYNC) utilise solida_app (lecture/ecriture) — meme forme d'URL pour
# les deux, le pilote psycopg 3 gere sync et async sous le meme schema "postgresql+psycopg://".
CORESIM_DATABASE_URL=postgresql+psycopg://solida_lecteur:REMPLACER_MOI@postgres-coresim:5432/coresim
SOLIDA_DATABASE_URL=postgresql+psycopg://solida_app:REMPLACER_MOI@postgres-solida:5432/solida
SOLIDA_DATABASE_URL_ASYNC=postgresql+psycopg://solida_app:REMPLACER_MOI@postgres-solida:5432/solida

# Secret de signature (reset password / verification FastAPI-Users). 32 octets alea minimum,
# jamais la valeur d'exemple ci-dessous en dehors du developpement local.
SECRET_AUTH=REMPLACER_MOI_PAR_UN_SECRET_ALEATOIRE_LONG
ENVIRONNEMENT=developpement
